## İşbaşı API Ayarları v2.0 (Production-Ready)
## NOT: Bu dosyayı kopyalayıp `.env` yapın ve değerleri doldurun.
## `.env` dosyası git'e eklenmez.

# === API Credentials (Zorunlu) ===
ISBASI_API_KEY=YOUR_API_KEY_HERE
ISBASI_USERNAME=your.email@example.com

# === Non-Interactive Password (Önerilen: Production/Cron için) ===
# Eğer set edilirse, agent'lar interactive şifre sormaz
ISBASI_PASSWORD=

# === API Endpoint (Opsiyonel) ===
ISBASI_BASE_URL=https://mw-jplatform.isbasi.com
ISBASI_VERIFY_SSL=true
# Giden fatura ürün satırları için UBL/XML endpoint'i.
# Boş bırakılırsa varsayılan İşbaşı endpoint adayları denenir.
ISBASI_OUTGOING_UBL_ENDPOINT=

# === User Info (Opsiyonel - header'lar için) ===
ISBASI_USER_ID=
ISBASI_USER_EMAIL=
ISBASI_TENANT_ID=

# === PostgreSQL (Zorunlu: stateful ingestion için) ===
# Database URL for backend agents (incoming_agent.py, outgoing_agent.py)
# Format: postgresql://user:password@host:port/database
# Example:
# DB_URL=postgresql://invoices_user:password@localhost:5432/invoices
DB_URL=

# Alternative name (both DB_URL and PG_DSN are supported)
PG_DSN=

# === Performance Tuning (Opsiyonel) ===
BATCH_SIZE=100          # Batch upsert size (100-500 recommended)
MAX_RETRIES=3           # API retry attempts
RETRY_DELAY=2.0         # Initial retry delay in seconds

# === Web Panel (Opsiyonel) ===
# VPS/internet kullanımında bu değerleri mutlaka değiştirin.
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=
WEB_SECRET_KEY=
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_SESSION_COOKIE_SECURE=false


